    "consentToTermsOfOLXLabel" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I agree to the service's terms of use, as well as to the transfer and processing of my data by OLX. I confirm that I am of legal age and take responsibility for posting the advertisement."
